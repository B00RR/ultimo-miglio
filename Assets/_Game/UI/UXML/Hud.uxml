<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/USS/DioramaSolare.uss" /><Style src="project://database/Assets/_Game/UI/Tokens.uss" /><Style src="project://database/Assets/_Game/UI/USS/HudV2.uss" /><Style src="project://database/Assets/_Game/UI/USS/Settings.uss" />
    <Style src="project://database/Assets/_Game/UI/USS/LegnoCartone.uss" />
    <Style src="project://database/Assets/_Game/UI/USS/TutorialHud.uss" />
    <Style src="project://database/Assets/_Game/UI/USS/Onboarding.uss" />
    <Style src="project://database/Assets/_Game/UI/USS/Etichette.uss" />
    <ui:VisualElement name="hud-root" class="fill hud--minimal" picking-mode="Ignore">
        <ui:VisualElement name="world-layer" class="layer" picking-mode="Ignore" />
        <ui:VisualElement name="popup-layer" class="layer" picking-mode="Ignore" />
        <ui:VisualElement name="joystick-base" picking-mode="Ignore"><ui:VisualElement name="joystick-knob" picking-mode="Ignore" /></ui:VisualElement>
        <ui:VisualElement name="edge-arrow" picking-mode="Ignore" style="display: none;">
            <ui:VisualElement name="edge-arrow-head" picking-mode="Ignore"><ui:VisualElement class="icon icon-arrow" picking-mode="Ignore" /></ui:VisualElement>
            <ui:Label name="edge-arrow-label" class="pill" text="Cliente al Bancone · 12 m" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="target-marker" picking-mode="Ignore" style="display: none;" />
        <ui:VisualElement name="safe-root" picking-mode="Ignore">
            <ui:VisualElement class="top-bar" picking-mode="Ignore">
                <ui:VisualElement class="top-left" picking-mode="Ignore">
                    <ui:VisualElement name="currency-slot" class="currency-slot">
                    <ui:VisualElement name="currency-pill" class="pill">
                        <ui:VisualElement class="currency"><ui:VisualElement class="icon icon-coin" /><ui:Label name="ln-value" class="currency-value" text="0" /></ui:VisualElement>
                        <ui:VisualElement name="day-group" class="currency day-group"><ui:Label name="day-value" class="day-value" text="G1" /></ui:VisualElement>
                        <ui:VisualElement class="currency bolt-group" style="display: none;"><ui:VisualElement class="icon icon-bolt" /><ui:Label name="bolt-value" class="currency-value" text="0" /></ui:VisualElement>
                        <ui:VisualElement name="token-group" class="currency" style="display: none;"><ui:VisualElement class="icon icon-token" /><ui:Label name="token-value" class="currency-value" text="0" /></ui:VisualElement>
                    </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="toll-chip" style="display: none;" class="pill hud-hide"><ui:VisualElement class="icon icon--sm icon-toll" /><ui:Label name="toll-value" text="Pedaggio" /></ui:VisualElement>
                    <ui:VisualElement name="toast" style="display: none;" class="pill" picking-mode="Ignore"><ui:Label name="toast-text" text="La Cassa ha 0 LN" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="settings-button" class="settings-btn" picking-mode="Position"><ui:VisualElement class="icon icon-gear" /></ui:VisualElement>
                <ui:VisualElement name="phone-button"><ui:VisualElement class="icon icon-phone" /><ui:Label name="phone-key-hint" class="key-hint" text="TAB" picking-mode="Ignore" /><ui:Label name="phone-badge" class="badge" text="" style="display: none;" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="objective-slot" class="objective-slot" picking-mode="Ignore">
                <ui:VisualElement name="objective-pill" class="objective-pill" picking-mode="Ignore">
                    <ui:Label name="tutorial-objective" class="tutorial-objective" text="Muoviti" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="top-center" picking-mode="Ignore"><ui:VisualElement name="room-pill" style="display: none;" class="pill hud-hide" picking-mode="Ignore"><ui:VisualElement class="icon icon--sm icon-door" picking-mode="Ignore" /><ui:Label name="room-name" text="Magazzino" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="bottom-dock" picking-mode="Ignore"><ui:VisualElement name="safe-card" style="display: none;" class="panel">
                <ui:VisualElement name="safe-toll"><ui:Label name="safe-toll-text" text="PEDAGGIO OMNIFREIGHT" /></ui:VisualElement>
                <ui:VisualElement class="row"><ui:VisualElement class="icon icon-safe" /><ui:Label name="safe-title" text="Cassaforte" /></ui:VisualElement>
                <ui:Label name="safe-day" text="Giorno 1/365" />
                <ui:Label name="safe-installment" text="Rata 1" />
                <ui:VisualElement class="progress"><ui:VisualElement name="safe-progress-fill" class="progress-fill" /></ui:VisualElement>
                <ui:Label name="safe-progress-text" text="" />
                <ui:Label name="safe-close" text="×" />
            </ui:VisualElement></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="settings-root" class="fill" picking-mode="Ignore" style="display: none;">
            <ui:VisualElement name="settings-scrim" class="settings-scrim">
                <ui:VisualElement name="settings-panel" class="settings-panel" picking-mode="Position">
                    <ui:Label name="settings-title" class="settings-title" text="Impostazioni" picking-mode="Ignore" />
                    <ui:VisualElement class="settings-row" picking-mode="Ignore">
                        <ui:Label class="settings-label" text="Zoom" picking-mode="Ignore" />
                        <ui:VisualElement class="settings-zoom-group" picking-mode="Ignore">
                            <ui:Button name="zoom-minus" class="settings-zoom-btn" text="−" />
                            <ui:Label name="zoom-value" class="settings-zoom-value" text="—" picking-mode="Ignore" />
                            <ui:Button name="zoom-plus" class="settings-zoom-btn" text="+" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-row" picking-mode="Ignore">
                        <ui:Label class="settings-label" text="Musica" picking-mode="Ignore" />
                        <ui:Slider name="slider-music" class="settings-slider" low-value="0" high-value="1" value="0.6" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-row" picking-mode="Ignore">
                        <ui:Label class="settings-label" text="Suoni" picking-mode="Ignore" />
                        <ui:Slider name="slider-sfx" class="settings-slider" low-value="0" high-value="1" value="1" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-actions" picking-mode="Ignore">
                        <ui:Button name="settings-save" class="settings-btn-save" text="Salva" />
                        <ui:Button name="settings-back" class="settings-btn-back" text="Indietro" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
