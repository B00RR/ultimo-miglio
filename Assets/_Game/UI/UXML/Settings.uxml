<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/Tokens.uss" />
    <Style src="project://database/Assets/_Game/UI/USS/HudV2.uss" />
    <Style src="project://database/Assets/_Game/UI/USS/Settings.uss" />
    <ui:VisualElement name="settings-root" class="fill" picking-mode="Ignore" style="display: none;">
        <ui:VisualElement name="settings-scrim" class="settings-scrim">
            <ui:VisualElement name="settings-panel" class="settings-panel" picking-mode="Position">
                <ui:Label name="settings-title" class="settings-title" text="Impostazioni" picking-mode="Ignore" />
                <ui:Label name="settings-cam-title" class="settings-section" text="Visuale" picking-mode="Ignore" />
                <ui:VisualElement class="settings-cam-row" picking-mode="Ignore">
                    <ui:VisualElement class="settings-cam-head" picking-mode="Ignore">
                        <ui:Label class="settings-label" text="Zoom" picking-mode="Ignore" />
                        <ui:Label name="cam-zoom-value" class="settings-cam-value" text="—" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-cam-zoom" class="settings-slider settings-slider--full" low-value="0.7" high-value="1.4" value="1" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-cam-row" picking-mode="Ignore">
                    <ui:VisualElement class="settings-cam-head" picking-mode="Ignore">
                        <ui:Label class="settings-label" text="Rotazione" picking-mode="Ignore" />
                        <ui:Label name="cam-rot-value" class="settings-cam-value" text="—" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-cam-rot" class="settings-slider settings-slider--full" low-value="-45" high-value="45" value="0" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-cam-row" picking-mode="Ignore">
                    <ui:VisualElement class="settings-cam-head" picking-mode="Ignore">
                        <ui:Label class="settings-label" text="Inclinazione" picking-mode="Ignore" />
                        <ui:Label name="cam-tilt-value" class="settings-cam-value" text="—" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-cam-tilt" class="settings-slider settings-slider--full" low-value="35" high-value="60" value="50" />
                </ui:VisualElement>
                <ui:Button name="cam-reset" class="settings-btn-reset" text="Ripristina vista" />
                <ui:VisualElement class="settings-row" picking-mode="Ignore">
                    <ui:Label class="settings-label" text="Musica" picking-mode="Ignore" />
                    <ui:Slider name="slider-music" class="settings-slider" low-value="0" high-value="1" value="0.6" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-row" picking-mode="Ignore">
                    <ui:Label class="settings-label" text="Suoni" picking-mode="Ignore" />
                    <ui:Slider name="slider-sfx" class="settings-slider" low-value="0" high-value="1" value="1" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-actions" picking-mode="Ignore">
                    <ui:Button name="settings-save" class="settings-btn-save" text="Salva" />
                    <ui:Button name="settings-back" class="settings-btn-back" text="Indietro" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
