/* Etichette #186. Baloo 2 = titoli e valori. Fredoka = testo.
   Insegna di noce (texture originale, niente 9-slice). Ombra #9E7873, contorno #3B2A20.
   Crema #F3E3C3 al posto del bianco. Oro #F2B53A solo come accento. */

.insegna-noce {
    background-color: #7A4A2E;
    background-image: url("project://database/Assets/_Game/UI/Textures/tex_insegna_noce.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: #3B2A20;
    border-radius: 8px;
}

.poi-chip {
    flex-direction: row;
    align-items: center;
    align-self: center;
    padding: 4px 12px 7px 8px;
    min-height: 28px;
}

.poi-chip__icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #F2B53A;
}

.poi-chip__valore {
    margin: 0;
    padding: 0 0 1px 0;
    font-size: 18px;
    color: #F3E3C3;
    white-space: nowrap;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Baloo2-Bold_SDF.asset");
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #3B2A20;
    text-shadow: 0 1px 0 #9E7873;
}

/* Titoli e valori. Il fondo dei pannelli non si tocca qui. */
.currency-value,
.day-value,
#pad-price,
.pad-tag__price,
#cassa-amount,
.collect-amount,
.combo-popup,
.stack-pill,
#room-name,
#safe-title,
.settings-title,
.poi-bar__label,
.nonno-badge__text {
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Baloo2-Bold_SDF.asset") !important;
    text-shadow: 0 1px 0 #9E7873;
}

/* Testo di lettura. */
.ada-text,
.tutorial-objective,
.tut-hint__text,
.settings-label,
#toast-text,
.skip-tut,
#edge-arrow-label,
.pad-tag__label {
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Fredoka-Medium_SDF.asset") !important;
}
