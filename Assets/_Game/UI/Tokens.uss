/* Ultimo Miglio - HUD tokens (minimale #38 + superfici Diorama #49). Units = dp. */
:root {
    --c-terracotta: #C8633B; --c-terracotta-dk: #8E3F22;
    --c-sun: #F4C430; --c-mint: #8FC9A8; --c-lemon: #F7E26B;
    --c-paper: #F3E3C3; --c-paper-hi: #E8D3AC; --c-ink: #3B2A20;
    --c-walnut: #7A4A2E; --c-wood: #74503A; --c-outline: #3B2F2A;
    --c-teal: #5E7F86; --c-teal-dk: #3E5A61;
    --c-paper-glass: rgba(243, 227, 195, 0.30); --c-ink-glass: rgba(59, 42, 32, 0.55);
    --bw: 3px; --bw-thick: 4px; --lip: 4px;
    --r-pill: 20px; --r-btn: 14px; --r-phone: 12px; --r-note: 12px; --r-toon: 16px;
    --sp-1: 4px; --sp-2: 8px; --sp-3: 10px; --sp-4: 12px;
    --fs-num: 18px; --fs-room: 13px; --fs-body: 13px; --fs-name: 14px; --fs-btn: 16px; --fs-pad-title: 12px; --fs-pad-price: 14px; --fs-chip: 13px;
    --font-round: url("project://database/Assets/_Game/UI/Fonts/Fredoka-Bold.ttf");
    --font-round-semi: url("project://database/Assets/_Game/UI/Fonts/Fredoka-SemiBold.ttf");
    color: var(--c-ink);
    font-size: var(--fs-body);
}

/* #49: superfici cartone su HUD minimo (LN/giorno, obiettivo, Ada 1 riga).
   Tokens carica prima di HudV2: !important batte le regole normali di HudV2 senza toccare quel file.
   Telefono NON montato qui (HUD minimo Lorenzo). CTA pollice omessa (contraddice HUD minimo).
   #185: il 9-slice ha gli angoli trasparenti (raggio 16 px, stesso bordo dello sprite).
   Un background-color opaco restava un quadrato sotto lo slice e gli angoli pieni si vedevano bianchi.
   Il raggio USS è 16 px, allineato al bordo: così la curva del PNG e il bordo coincidono. */
#currency-pill {
    border-width: var(--bw) !important;
    border-color: var(--c-outline) !important;
    background-color: rgba(0, 0, 0, 0) !important;
    background-image: url("project://database/Assets/_Game/UI/Textures/tex_cardboard_panel.png") !important;
    -unity-background-scale-mode: stretch-to-fill !important;
    -unity-slice-left: 16px;
    -unity-slice-top: 16px;
    -unity-slice-right: 16px;
    -unity-slice-bottom: 16px;
    border-radius: 16px !important;
}
.tutorial-objective {
    border-width: var(--bw) !important;
    border-color: var(--c-outline) !important;
    background-color: rgba(0, 0, 0, 0) !important;
    background-image: url("project://database/Assets/_Game/UI/Textures/tex_cardboard_panel.png") !important;
    -unity-background-scale-mode: stretch-to-fill !important;
    -unity-slice-left: 16px;
    -unity-slice-top: 16px;
    -unity-slice-right: 16px;
    -unity-slice-bottom: 16px;
    border-radius: 16px !important;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Fredoka-SemiBold.ttf") !important;
    color: var(--c-ink) !important;
}
.ada-note {
    border-width: var(--bw) !important;
    border-bottom-width: var(--bw-thick) !important;
    border-color: var(--c-outline) !important;
    background-color: rgba(0, 0, 0, 0) !important;
    background-image: url("project://database/Assets/_Game/UI/Textures/tex_cardboard_panel.png") !important;
    -unity-background-scale-mode: stretch-to-fill !important;
    -unity-slice-left: 16px;
    -unity-slice-top: 16px;
    -unity-slice-right: 16px;
    -unity-slice-bottom: 16px;
    border-radius: 16px !important;
}
/* #185: il tema dei Button dipinge uno sprite 9-slice bianco. Senza questo, Salta tutorial
   e gli altri pulsanti tengono gli angoli quadrati bianchi sopra il nostro colore. */
.unity-button {
    background-image: none !important;
}
.day-value,
.currency-value {
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Fredoka-Bold.ttf") !important;
    color: var(--c-ink) !important;
}
